NEXT_PUBLIC_MIXPANEL_TOKEN=
NEXT_PUBLIC_AMPLITUDE_API_KEY=
# Supabase (Project Settings > API). 비워 두면 localStorage 만으로 동작하는 프로토타입 모드. 설정은 docs/supabase-설정.md
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 구글 로그인 화면 표시. "false"면 숨김(로그인 없이 쓰는 버전). 비우면 표시. 바꾸면 다시 배포해야 반영된다
NEXT_PUBLIC_LOGIN_ENABLED=
